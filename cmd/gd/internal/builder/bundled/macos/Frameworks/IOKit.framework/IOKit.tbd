--- !tapi-tbd
tbd-version:  4
install-name: '/System/Library/Frameworks/IOKit.framework/Versions/A/IOKit'
targets:
 - x86_64-macos
 - arm64-macos
exports:
 - targets: [ x86_64-macos, arm64-macos ]
   symbols:
    - _kIOMainPortDefault
    - _kIOMasterPortDefault

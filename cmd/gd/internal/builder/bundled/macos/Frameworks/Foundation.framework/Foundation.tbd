--- !tapi-tbd
tbd-version:  4
install-name: '/System/Library/Frameworks/Foundation.framework/Versions/C/Foundation'
targets:
 - x86_64-macos
 - arm64-macos
exports:
 - targets: [ x86_64-macos, arm64-macos ]
   symbols:
    - _NSLog
    - _NSSearchPathForDirectoriesInDomains
    - _NSTemporaryDirectory
    - _NSLocalizedDescriptionKey
    - _NSBundleDidLoadNotification
    - _NSBundleResourceRequestLowDiskSpaceNotification
    - _NSCocoaErrorDomain
    - _NSDebugDescriptionErrorKey
    - _NSFilePathErrorKey
    - _NSHelpAnchorErrorKey
    - _NSLocalizedFailureErrorKey
    - _NSLocalizedFailureReasonErrorKey
    - _NSLocalizedRecoveryOptionsErrorKey
    - _NSLocalizedRecoverySuggestionErrorKey
    - _NSMachErrorDomain
    - _NSOSStatusErrorDomain
    - _NSPOSIXErrorDomain
    - _NSProcessInfoPowerStateDidChangeNotification
    - _NSProcessInfoThermalStateDidChangeNotification
    - _NSRecoveryAttempterErrorKey
    - _NSStringEncodingErrorKey
    - _NSURLErrorKey
    - _NSUnderlyingErrorKey
   objc-classes:
    - NSAttributedString
    - NSBundle
    - NSCharacterSet
    - NSDistributedNotificationCenter
    - NSFileManager
    - NSLayoutConstraint
    - NSMutableAttributedString
    - NSNotificationCenter
    - NSNumber
    - NSPredicate
    - NSProcessInfo
    - NSString
    - NSError
    - NSMutableString
    - NSThread
    - NSUUID
...

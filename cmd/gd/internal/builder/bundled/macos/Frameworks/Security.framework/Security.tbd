--- !tapi-tbd
tbd-version:  4
install-name: '/System/Library/Frameworks/Security.framework/Versions/A/Security'
targets:
 - x86_64-macos
 - arm64-macos
 - arm64-ios
exports:
 - targets: [ x86_64-macos, arm64-macos, arm64-ios ]
   symbols:
    - _SecCertificateCopyData
    - _SecCertificateCreateWithData
    - _SecPolicyCreateSSL
    - _SecTrustCopyAnchorCertificates
    - _SecTrustCopyCertificateChain
    - _SecTrustCreateWithCertificates
    - _SecTrustEvaluateWithError
    - _SecTrustGetCertificateAtIndex
    - _SecTrustGetCertificateCount
    - _SecTrustSetVerifyDate
...

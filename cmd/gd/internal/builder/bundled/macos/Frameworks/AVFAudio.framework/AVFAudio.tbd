--- !tapi-tbd
tbd-version:  4
install-name: '/System/Library/Frameworks/AVFAudio.framework/Versions/A/AVFAudio'
targets:
 - x86_64-macos
 - arm64-macos
exports:
 - targets: [ x86_64-macos, arm64-macos ]
   symbols:
    - _AVSpeechUtteranceDefaultSpeechRate
    - _AVSpeechUtteranceMaximumSpeechRate
    - _AVSpeechUtteranceMinimumSpeechRate
   objc-classes:
    - AVSpeechSynthesisVoice
    - AVSpeechSynthesizer
    - AVSpeechUtterance
...

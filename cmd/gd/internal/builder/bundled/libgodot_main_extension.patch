diff --git a/core/extension/godot_instance.cpp b/core/extension/godot_instance.cpp
index b5c99eb22e..bbbfc9a40f 100644
--- a/core/extension/godot_instance.cpp
+++ b/core/extension/godot_instance.cpp
@@ -57,7 +57,14 @@ bool GodotInstance::initialize(GDExtensionInitializationFunction p_init_func) {
 	print_verbose("Godot Instance initialization");
 	GDExtensionManager *gdextension_manager = GDExtensionManager::get_singleton();
 	GDExtensionConstPtr<const GDExtensionInitializationFunction> ptr((const GDExtensionInitializationFunction *)&p_init_func);
-	GDExtensionManager::LoadStatus status = gdextension_manager->load_extension_from_function("libgodot://main", ptr);
+	// see register_core_extensions.
+	String path = gdextension_manager->get_host_extension_path();
+	if (path.is_empty()) {
+		GDExtensionManager::LoadStatus status = gdextension_manager->load_extension_from_function("libgodot://main", ptr);
+		return status == GDExtensionManager::LoadStatus::LOAD_STATUS_OK;
+	}
+	GDExtensionManager::LoadStatus status = gdextension_manager->load_extension_from_function(path, ptr);
+	gdextension_manager->load_extensions(); // skips the path, it is loaded.
 	return status == GDExtensionManager::LoadStatus::LOAD_STATUS_OK;
 }
 
diff --git a/core/register_core_types.cpp b/core/register_core_types.cpp
index 80696814aa..ac2a7b34a1 100644
--- a/core/register_core_types.cpp
+++ b/core/register_core_types.cpp
@@ -394,7 +394,20 @@ void register_core_extensions() {
 
 	// Hardcoded for now.
 	GDExtension::initialize_gdextensions();
-	gdextension_manager->load_extensions();
+#ifdef LIBGODOT_ENABLED
+	// A program that embeds the engine with an extension of its own linked in
+	// can name the .gdextension file of that extension, so that the extension
+	// is registered under that path (see GodotInstance::initialize) instead of
+	// being loaded a second time from the file's libraries. The project's
+	// extensions are then loaded after it.
+	String host_extension = OS::get_singleton()->get_environment("LIBGODOT_MAIN_EXTENSION");
+	if (!host_extension.is_empty()) {
+		// It is for this process, not the ones it starts.
+		OS::get_singleton()->unset_environment("LIBGODOT_MAIN_EXTENSION");
+		gdextension_manager->set_host_extension_path(host_extension);
+	} else
+#endif
+		gdextension_manager->load_extensions();
 	gdextension_manager->initialize_extensions(GDExtension::INITIALIZATION_LEVEL_CORE);
 	_is_core_extensions_registered = true;
 
